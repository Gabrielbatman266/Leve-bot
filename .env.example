# Copie este arquivo para .env e preencha

# ── Telegram ──
BOT_TOKEN=123456:ABC...           # do @BotFather
ADMIN_ID=123456789                # seu ID do Telegram (recebe aviso de cada venda)

# ── Painel ──
PANEL_PASSWORD=troque-esta-senha  # senha para entrar no painel
PANEL_PORT=8080
PANEL_HOST=127.0.0.1              # deixe assim (só acessível no próprio aparelho/servidor)

# ── SyncPay (Pix em R$) ── painel SyncPay > Developer > API (deixe "Saque" desmarcado)
SYNCPAY_CLIENT_ID=
SYNCPAY_CLIENT_SECRET=

# ── Stripe (cartão em US$ e €) ── OPCIONAL. Vazio = só Pix.
STRIPE_SECRET_KEY=

# ── Só se o painel tiver endereço público com HTTPS (servidor) ──
# Com isso o SyncPay avisa o pagamento na hora (webhook). Sem isso, o bot confere a cada 30 s.
PUBLIC_URL=
SYNCPAY_WEBHOOK_TOKEN=

# ── Primeiro plano (criado só na primeira vez; depois edite no painel) ──
GROUP_ID=-1001234567890
PLAN_NAME=VIP Mensal
PLAN_DAYS=30
PRICE_BRL=2990
